    {
      "parameters": {
        "jsCode": "// One output item per email.\n// 'Get many labels' runs once per email, so its output contains one copy of the label list per email â€” dedupe it first.\n// Category comes from the paired HTTP Request item; message id comes from the paired extract item (HTTP Request replaces item data with the API response).\n\nconst httpItems = $('HTTP Request').all();\nconst extractItems = $('extract').all();\nconst labelItems = $input.all();\n\n// Dedupe the label list (id -> name)\nconst labelMap = {};\nfor (const item of labelItems) {\n  if (item.json && item.json.id && !labelMap[item.json.id]) {\n    labelMap[item.json.id] = item.json.name;\n  }\n}\n\nconst out = [];\n\nfor (let i = 0; i < httpItems.length; i++) {\n  const answers = httpItems[i].json.answers || {};\n  const category = answers.category && answers.category.choice ? answers.category.choice : null;\n\n  if (!category) continue; // skip if the categorizer returned nothing\n\n  const labelName = 'system_one_' + category;\n  let labelExists = false;\n  let labelId = null;\n\n  for (const [id, name] of Object.entries(labelMap)) {\n    if (name === labelName) {\n      labelExists = true;\n      labelId = id;\n      break;\n    }\n  }\n\n  out.push({\n    json: {\n      labelExists: labelExists,\n      labelName: labelName,\n      labelId: labelId,\n      messageId: extractItems[i].json.id\n    }\n  });\n}\n\nreturn out;"
      },
