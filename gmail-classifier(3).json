        "url": "https://api.typesafe.ai/v1/systemone",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"state\": \"This is an email from : {{ $json.from }}, with subject {{ $json.subject }}: it read as follows : {{ $json.snippet }}\",\n  \"model\": \"jev-latest\",\n  \"questions\": {\n    \"category\": {\n      \"type\": \"choice\",\n      \"instructions\": \"What category does this fall in\",\n      \"criteria\": {\n        \"spam\": \"spam or promotional messages with no releavance\",\n        \"college\": \"college mail with information and college related updates\",\n        \"opportunity\": \"opportunities for events, jobs, internships\",\n        \"update\": \"regular updates from services informing about changes\",\n        \"important\": \"critical messaging\",\n        \"verification\": \"OTPs and confirmational messaging\",\n        \"feed\": \"subscribed rss feeds or news\" \n      }\n    }\n  }\n} ",
        "options": {}
      },
