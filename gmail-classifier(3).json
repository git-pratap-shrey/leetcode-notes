    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TRUNCATE_LENGTH = 2000; // ~10x Gmail's snippet length\n\nfunction sanitizeForJson(str) {\n  return String(str || '')\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\r?\\n/g, '\\\\n')\n    .replace(/\\t/g, '\\\\t');\n}\n\nreturn {\n  json: {\n    subject: $json.subject,\n    from: $json.from?.value?.[0]?.address || '',\n    id: $json.id,\n    snippet: sanitizeForJson(($json.text || '').slice(0, TRUNCATE_LENGTH))\n  }\n};"
      },
