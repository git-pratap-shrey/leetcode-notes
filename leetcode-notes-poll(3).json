      "name": "HTTP Request1",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const tasks = $('make_tasks1').all();\nconst rows = $('parse_rows1').all().map(i => ({ ...i.json }));\nconst byId = Object.fromEntries(rows.map(r => [r.ques_id, r]));\n$input.all().forEach((it, i) => {\n  const t = tasks[i]?.json, r = it.json;\n  if (!t?.ques_id || !byId[t.ques_id]) return;          // sentinel / unknown row\n  if (r.status !== 'completed' || !r.response) return;  // queued / processing / failed / http error\n  byId[t.ques_id][t.kind === 'revision' ? 'revision_text' : 'review_text'] = r.response;\n});\nreturn rows.map(r => ({ json: r }));"
      },
