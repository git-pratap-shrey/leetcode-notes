    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const { json: r } of $input.all()) {\n  if (!r.revision_text) out.push({ json: { ques_id: r.ques_id, kind: 'revision', job_id: r.revision_job } });\n  if (!r.review_text)   out.push({ json: { ques_id: r.ques_id, kind: 'analysis', job_id: r.analysis_job } });\n}\n// nothing left to poll (e.g. a commit failed last run): pass a sentinel so `apply` still runs\nreturn out.length ? out : [{ json: { noop: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2512,
        1344
      ],
