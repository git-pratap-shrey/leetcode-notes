    {
      "parameters": {
        "jsCode": "const solvedItems = $('committed').all();\nconst meta = $input.first().json || {};\n\nconst ensureNewFormat = (q) => {\n  if (typeof q === 'object') return q;\n  return { date: null, language: null };\n};\n\nfor (const item of solvedItems) {\n  const { username, title_slug: titleSlug, solved_at: solvedAt, lang: langName } = item.json;\n  if (!username) continue;\n\n  if (!meta[username]) {\n    meta[username] = { questions: {} };\n  }\n\n  if (!meta[username].questions || Array.isArray(meta[username].questions)) {\n    meta[username].questions = Array.isArray(meta[username].questions)\n      ? Object.fromEntries(meta[username].questions.map(q => [q, ensureNewFormat(q)]))\n      : (meta[username].questions || {});\n  }\n\n  let lang = 'cpp';\n  if (langName) {\n    lang = langName === 'C++' ? 'cpp' : langName.toLowerCase();\n  }\n\n  if (!meta[username].questions[titleSlug]) {\n    meta[username].questions[titleSlug] = { date: solvedAt, language: lang };\n  }\n}\n\nreturn [{ json: meta }];"
      },
