        "jsCode": "const username = $node[\"extract username1\"].json.username.trim();\n\nconst encoded = $input.first().json.content || '';\n\nconst raw = Buffer.from(encoded, 'base64').toString('utf-8');\n\nconst meta = JSON.parse(raw);\n\nif (meta[username]) {\n  return [{ json: { status: 'exists', username, meta } }];\n}\n\nmeta[username] = { questions: {} };\n\nreturn [{ json: { status: 'new', username, meta } }];"
      },
